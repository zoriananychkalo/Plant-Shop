<main>


  <article>
    <img class="product-detail-image" src="{{product.image}}" alt="{{product.alt}}" width="400">
    <h1>{{product.name}}</h1>
    <p>Category: {{product.category}}</p>
    <p>{{product.description}}</p>
    <p>Price: {{euro product.price}}</p>
    <button type="button" data-add-to-cart="{{product.id}}">Add to cart</button>
    <p data-cart-message aria-live="polite"></p>
  </article>
</main>